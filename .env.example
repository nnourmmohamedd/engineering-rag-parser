# Copy to .env and adjust. NEVER commit .env — it is git-ignored.
# This project needs no secrets: it is entirely local and contacts no service.

# --- Offline / model artifacts ---------------------------------------------
# Local Docling model cache. Set this to run fully offline after the first
# download (docling-tools models download -o <dir>).
# ENGRAG_ARTIFACTS_PATH=./models/docling

# Force HuggingFace into offline mode once weights are cached.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# HF_HOME=./models/huggingface

# --- Runtime ----------------------------------------------------------------
# ENGRAG_LOG_LEVEL=INFO
# ENGRAG_NUM_THREADS=4
# ENGRAG_ACCELERATOR_DEVICE=cpu       # cpu | cuda | mps | xpu | auto

# Cap intra-op threads for reproducible CPU timings.
# OMP_NUM_THREADS=4
