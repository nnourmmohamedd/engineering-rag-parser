# --- Virtual environments ---
.venv/
venv/
env/

# --- Python bytecode / build ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Test / tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Notebooks ---
.ipynb_checkpoints/
notebooks/**/*.nbconvert.ipynb

# --- Confidential source documents (NEVER commit) ---
data/input/
data/**/*.pdf
*.pdf
!tests/fixtures/**/*.pdf

# --- Generated run artifacts (contain extracted document content) ---
artifacts/
quarantine/
*.jsonl

# --- Model caches ---
models/
.cache/
.docling/
.EasyOCR/
huggingface/

# --- Secrets / local config ---
.env
.env.local
*.key
*.pem

# --- Logs ---
logs/
*.log

# --- OS noise ---
Thumbs.db
.DS_Store
desktop.ini
