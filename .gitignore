# --- Virtual environments ---
.venv/
venv/
env/

# --- Python bytecode / build ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Test / tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Notebooks ---
.ipynb_checkpoints/
notebooks/**/*.nbconvert.ipynb

# --- Confidential source documents (NEVER commit) ---
data/input/**
data/**/*.pdf
*.pdf
!tests/fixtures/**/*.pdf
!data/input/.gitkeep

# --- Generated run artifacts (contain extracted document content) ---
data/output/**
!data/output/.gitkeep
# Pre-migration output root; retained so any pre-existing local runs stay ignored.
artifacts/
quarantine/
*.jsonl
!data/eval/*.jsonl

# --- Model caches ---
models/
.cache/
.docling/
.EasyOCR/
huggingface/

# --- Secrets / local config ---
.env
.env.local
*.key
*.pem

# --- Logs ---
logs/
*.log

# --- OS noise ---
Thumbs.db
.DS_Store
desktop.ini

# --- Frontend (apps/rag-chatbot) ---
node_modules/
apps/*/dist/
apps/*/coverage/
apps/*/playwright-report/
apps/*/test-results/
apps/*/blob-report/
apps/*/.vite/
apps/*/*.local
apps/*/*.tsbuildinfo

# --- Chatbot backend local application state (registry DB, uploads, artifacts) ---
data/chatbot/
apps/*/e2e/.tmp-data/

# Synthetic E2E fixture PDFs are intentionally committed (not real/confidential data).
!apps/rag-chatbot/e2e/fixtures/sample.pdf
!apps/rag-chatbot/e2e/fixtures/sample-real.pdf
